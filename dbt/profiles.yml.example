# Copy to dbt/profiles.yml (gitignored): cp dbt/profiles.yml.example dbt/profiles.yml
# dbt is always invoked with --profiles-dir dbt, so this file is found there.
cvm_funds_fidc_analytics:
  target: duckdb
  outputs:
    # Default: local DuckDB file. Path is relative to the directory dbt runs from
    # (the repo root when using the Makefile or CI).
    duckdb:
      type: duckdb
      path: "{{ env_var('DUCKDB_PATH', 'data/duckdb/cvm_dev.duckdb') }}"
      schema: cvm
      threads: 4

    # Optional: Snowflake. Every value comes from the environment (see .env.example).
    # Authentication: key-pair (SNOWFLAKE_PRIVATE_KEY_PATH or SNOWFLAKE_PRIVATE_KEY,
    # optional SNOWFLAKE_PRIVATE_KEY_PASSPHRASE) OR password (SNOWFLAKE_PASSWORD).
    # Leave the unused method's variables empty.
    snowflake:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD', '') }}"
      private_key_path: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PATH', '') }}"
      private_key: "{{ env_var('SNOWFLAKE_PRIVATE_KEY', '') }}"
      private_key_passphrase: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PASSPHRASE', '') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE') }}"
      database: "{{ env_var('SNOWFLAKE_DATABASE') }}"
      schema: "{{ env_var('SNOWFLAKE_SCHEMA', 'cvm') }}"
      threads: "{{ env_var('SNOWFLAKE_THREADS', '4') | int }}"
      query_tag: "{{ env_var('SNOWFLAKE_QUERY_TAG', 'cvm_funds_fidc_analytics') }}"
      client_session_keep_alive: false
