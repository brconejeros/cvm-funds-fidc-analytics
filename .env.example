# Copy to .env and fill in locally. .env is gitignored — never commit real values.
# Only needed for the optional Snowflake target. The default DuckDB target needs none of these.

# --- Connection ---------------------------------------------------------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=

# --- Authentication: choose ONE method ----------------------------------------
# Key-pair (recommended): set SNOWFLAKE_PRIVATE_KEY_PATH to a local .p8 file
# OR SNOWFLAKE_PRIVATE_KEY to the PEM contents. The passphrase is only needed
# if the key is encrypted. Leave SNOWFLAKE_PASSWORD empty when using key-pair.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Password: set SNOWFLAKE_PASSWORD and leave the three key-pair variables empty.
SNOWFLAKE_PASSWORD=

# --- Context ------------------------------------------------------------------
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_THREADS=4
SNOWFLAKE_QUERY_TAG=cvm_funds_fidc_analytics
